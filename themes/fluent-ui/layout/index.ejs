<section class="post-list" id="post-list" data-layout="list">
  <div class="layout-switch" role="group" aria-label="布局切换">
    <fluent-button data-layout="list" appearance="accent">列表</fluent-button>
    <fluent-button data-layout="card" appearance="neutral">卡片</fluent-button>
    <fluent-button data-layout="magazine" appearance="neutral">杂志</fluent-button>
  </div>

  <% if (site.posts && site.posts.length) { %>
    <% site.posts.sort('date', -1).limit(20).forEach(function(post){ %>
      <fluent-card class="post-card">
        <h2 class="post-title">
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </h2>
        <div class="post-meta">
          <time><%= date(post.date, 'YYYY-MM-DD') %></time>
          <% if (post.categories && post.categories.length) { %>
            <fluent-badge appearance="accent" class="post-cat"><%= post.categories.map(function(c){return c.name;}).join(' / ') %></fluent-badge>
          <% } %>
        </div>
        <div class="post-excerpt"><%- post.excerpt || truncate(strip_html(post.content), {length: 160, omission: '…'}) %></div>
        <fluent-anchor class="read-more" href="<%- url_for(post.path) %>" appearance="hypertext">阅读全文 →</fluent-anchor>
      </fluent-card>
    <% }); %>
  <% } else { %>
    <fluent-card><p class="empty">还没有文章。</p></fluent-card>
  <% } %>
</section>
