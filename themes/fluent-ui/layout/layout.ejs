<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><% if (page.title) { %><%= page.title %> | <% } %><%= config.title %></title>
  <meta name="description" content="<%- config.description || '' %>">
  <% if (config.author) { %><meta name="author" content="<%= config.author %>"><% } %>
  <link rel="stylesheet" href="<%- url_for('css/fluent-theme.css') %>">
  <!-- Fluent UI Web Components v3（微软官方，纯 Web Components，非 .NET）：注册全部 <fluent-*> 组件 -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/@fluentui/web-components@3.1.3/dist/web-components-all.min.js"></script>
</head>
<body>
  <header class="app-header">
    <fluent-anchor class="brand" href="<%- url_for('/') %>" appearance="neutral"><%= config.title %></fluent-anchor>
    <nav class="top-nav">
      <fluent-anchor href="<%- url_for('/') %>" appearance="neutral">首页</fluent-anchor>
      <fluent-anchor href="<%- url_for('/archives/') %>" appearance="neutral">归档</fluent-anchor>
      <fluent-anchor href="<%- url_for('/tags/') %>" appearance="neutral">标签</fluent-anchor>
      <fluent-anchor href="<%- url_for('/categories/') %>" appearance="neutral">分类</fluent-anchor>
      <fluent-anchor href="<%- url_for('/about/') %>" appearance="neutral">关于</fluent-anchor>
    </nav>
  </header>

  <div class="app-shell">
    <aside class="app-sidebar">
      <fluent-card class="side-card">
        <fluent-text weight="semibold" size="500">导航</fluent-text>
        <fluent-divider></fluent-divider>
        <ul class="side-nav">
          <li><fluent-anchor href="<%- url_for('/') %>" appearance="neutral">首页</fluent-anchor></li>
          <li><fluent-anchor href="<%- url_for('/archives/') %>" appearance="neutral">归档</fluent-anchor></li>
          <li><fluent-anchor href="<%- url_for('/tags/') %>" appearance="neutral">标签</fluent-anchor></li>
          <li><fluent-anchor href="<%- url_for('/categories/') %>" appearance="neutral">分类</fluent-anchor></li>
          <li><fluent-anchor href="<%- url_for('/about/') %>" appearance="neutral">关于</fluent-anchor></li>
        </ul>
      </fluent-card>
    </aside>

    <main class="app-main">
      <%- body %>
    </main>
  </div>

  <footer class="app-footer">
    <p>© <%= date(new Date(), 'YYYY') %> <%= config.title %> · Powered by Hexo + Fluent UI Web Components</p>
  </footer>

  <script type="module" src="<%- url_for('js/app.js') %>"></script>
</body>
</html>
