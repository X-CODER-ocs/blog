/* ============================================================
   MD3 (Material You) 皮肤 — 叠加在 NexT 之上
   · 设计令牌来自 seed #4AA26F，由 material-color-utilities 生成
   · 运行时 dynamic-color.js 会把实时色板注入 --md-sys-color-*
   · 此处为「静态兜底」+ 组件化卡片 / 形状 / 阴影 / state layer
   ============================================================ */

/* ---------- 1. 设计令牌：浅色方案（种子 #4AA26F） ---------- */
:root {
  --md-brand: #4AA26F;
  --md-sys-state-primary: rgba(0, 109, 63, .08);

  --md-sys-color-primary: #006d3f;
  --md-sys-color-on-primary: #ffffff;
  --md-sys-color-primary-container: #95f7b9;
  --md-sys-color-on-primary-container: #002110;
  --md-sys-color-secondary: #4f6354;
  --md-sys-color-on-secondary: #ffffff;
  --md-sys-color-secondary-container: #d1e8d5;
  --md-sys-color-on-secondary-container: #0c1f14;
  --md-sys-color-tertiary: #3b6470;
  --md-sys-color-on-tertiary: #ffffff;
  --md-sys-color-tertiary-container: #bee9f7;
  --md-sys-color-on-tertiary-container: #001f27;
  --md-sys-color-error: #ba1a1a;
  --md-sys-color-on-error: #ffffff;
  --md-sys-color-error-container: #ffdad6;
  --md-sys-color-on-error-container: #410002;
  --md-sys-color-background: #fbfdf8;
  --md-sys-color-on-background: #191c1a;
  --md-sys-color-surface: #fbfdf8;
  --md-sys-color-on-surface: #191c1a;
  --md-sys-color-surface-variant: #dce5db;
  --md-sys-color-on-surface-variant: #414942;
  --md-sys-color-outline: #717971;
  --md-sys-color-outline-variant: #c0c9c0;
  --md-sys-color-shadow: #000000;
  --md-sys-color-scrim: #000000;
  --md-sys-color-inverse-surface: #2e312e;
  --md-sys-color-inverse-on-surface: #f0f1ec;
  --md-sys-color-inverse-primary: #79da9e;

  --md-elevation-1: 0 1px 2px rgba(0, 0, 0, .08), 0 1px 3px 1px rgba(0, 0, 0, .06);
  --md-elevation-2: 0 1px 2px rgba(0, 0, 0, .10), 0 2px 6px 2px rgba(0, 0, 0, .08);
  --md-elevation-3: 0 4px 8px 3px rgba(0, 0, 0, .10), 0 1px 3px rgba(0, 0, 0, .12);

  --md-radius-xs: 8px;
  --md-radius-sm: 12px;
  --md-radius-md: 16px;
  --md-radius-lg: 28px;
  --md-radius-pill: 999px;

  --md-font: "Roboto", "PingFang SC", "Microsoft YaHei", -apple-system,
    BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}

/* ---------- 2. 设计令牌：深色方案 ---------- */
@media (prefers-color-scheme: dark) {
  :root {
    --md-sys-state-primary: rgba(121, 218, 158, .10);
    --md-sys-color-primary: #79da9e;
    --md-sys-color-on-primary: #00391e;
    --md-sys-color-primary-container: #00522e;
    --md-sys-color-on-primary-container: #95f7b9;
    --md-sys-color-secondary: #b5ccba;
    --md-sys-color-on-secondary: #213528;
    --md-sys-color-secondary-container: #374b3d;
    --md-sys-color-on-secondary-container: #d1e8d5;
    --md-sys-color-tertiary: #a3cddb;
    --md-sys-color-on-tertiary: #033640;
    --md-sys-color-tertiary-container: #214c58;
    --md-sys-color-on-tertiary-container: #bee9f7;
    --md-sys-color-error: #ffb4ab;
    --md-sys-color-on-error: #690005;
    --md-sys-color-error-container: #93000a;
    --md-sys-color-on-error-container: #ffb4ab;
    --md-sys-color-background: #191c1a;
    --md-sys-color-on-background: #e1e3de;
    --md-sys-color-surface: #191c1a;
    --md-sys-color-on-surface: #e1e3de;
    --md-sys-color-surface-variant: #414942;
    --md-sys-color-on-surface-variant: #c0c9c0;
    --md-sys-color-outline: #8a938b;
    --md-sys-color-outline-variant: #414942;
    --md-sys-color-inverse-surface: #e1e3de;
    --md-sys-color-inverse-on-surface: #2e312e;
    --md-sys-color-inverse-primary: #006d3f;

    --md-elevation-1: 0 1px 3px rgba(0, 0, 0, .5);
    --md-elevation-2: 0 2px 6px 2px rgba(0, 0, 0, .5);
    --md-elevation-3: 0 6px 10px 4px rgba(0, 0, 0, .5);
  }
}

html.dark,
body.dark {
  --md-sys-state-primary: rgba(121, 218, 158, .10);
  --md-sys-color-primary: #79da9e;
  --md-sys-color-on-primary: #00391e;
  --md-sys-color-primary-container: #00522e;
  --md-sys-color-on-primary-container: #95f7b9;
  --md-sys-color-secondary: #b5ccba;
  --md-sys-color-on-secondary: #213528;
  --md-sys-color-secondary-container: #374b3d;
  --md-sys-color-on-secondary-container: #d1e8d5;
  --md-sys-color-tertiary: #a3cddb;
  --md-sys-color-on-tertiary: #033640;
  --md-sys-color-tertiary-container: #214c58;
  --md-sys-color-on-tertiary-container: #bee9f7;
  --md-sys-color-error: #ffb4ab;
  --md-sys-color-on-error: #690005;
  --md-sys-color-error-container: #93000a;
  --md-sys-color-on-error-container: #ffb4ab;
  --md-sys-color-background: #191c1a;
  --md-sys-color-on-background: #e1e3de;
  --md-sys-color-surface: #191c1a;
  --md-sys-color-on-surface: #e1e3de;
  --md-sys-color-surface-variant: #414942;
  --md-sys-color-on-surface-variant: #c0c9c0;
  --md-sys-color-outline: #8a938b;
  --md-sys-color-outline-variant: #414942;
  --md-sys-color-inverse-surface: #e1e3de;
  --md-sys-color-inverse-on-surface: #2e312e;
  --md-sys-color-inverse-primary: #006d3f;

  --md-elevation-1: 0 1px 3px rgba(0, 0, 0, .5);
  --md-elevation-2: 0 2px 6px 2px rgba(0, 0, 0, .5);
  --md-elevation-3: 0 6px 10px 4px rgba(0, 0, 0, .5);
}

/* ---------- 3. 全局基底 ---------- */
html { font-family: var(--md-font) !important; -webkit-font-smoothing: antialiased; }
body {
  background: var(--md-sys-color-background) !important;
  font-family: var(--md-font) !important;
  color: var(--md-sys-color-on-background) !important;
}

/* 动态取色切换时的平滑过渡 */
*, *::before, *::after {
  transition: background-color .3s ease, color .3s ease,
    border-color .3s ease, box-shadow .3s ease, fill .3s ease;
}

a { color: var(--md-sys-color-primary); text-decoration: none; }
a:hover { color: var(--md-sys-color-primary); }

/* ---------- 4. 组件化卡片：文章 ---------- */
.post-block,
.posts-expand .post {
  background: var(--md-sys-color-surface) !important;
  border-radius: var(--md-radius-md) !important;
  box-shadow: var(--md-elevation-1) !important;
  border: none !important;
  padding: 30px 34px !important;
  margin-bottom: 26px !important;
}
.posts-expand .post-block + .post-block { margin-top: 0 !important; }
.posts-expand .post-block::before,
.post-block::before { display: none !important; }

html.dark .post-block,
body.dark .post-block,
html.dark .posts-expand .post,
body.dark .posts-expand .post {
  border: 1px solid var(--md-sys-color-outline-variant) !important;
}

.post-title, .post-title a,
.site-title, .brand,
h1, h2, h3, h4, h5, h6 {
  color: var(--md-sys-color-on-surface) !important;
  font-weight: 700 !important;
}
.post-title a:hover { color: var(--md-sys-color-primary) !important; }

.post-body, .content, .post-block p, .post-body li {
  color: var(--md-sys-color-on-surface) !important;
}
.post-meta, .post-meta a, .post-time, .post-category, .post-category a {
  color: var(--md-sys-color-on-surface-variant) !important;
}

/* ---------- 5. 侧栏卡片 ---------- */
.sidebar-inner {
  background: var(--md-sys-color-surface) !important;
  border-radius: var(--md-radius-lg) !important;
  box-shadow: var(--md-elevation-1) !important;
  border: none !important;
  padding: 22px !important;
}
html.dark .sidebar-inner,
body.dark .sidebar-inner {
  border: 1px solid var(--md-sys-color-outline-variant) !important;
}
.site-author-image {
  border-radius: 50% !important;
  border: 3px solid var(--md-brand) !important;
  padding: 2px;
  background: var(--md-sys-color-surface);
}
.site-state, .links-of-author, .cc-license, .sidebar .site-state {
  border-radius: var(--md-radius-sm) !important;
}

/* ---------- 6. 按钮 / 分页 / 导航 ---------- */
.btn, .post-button .btn, .page-number, .extend, .menu-item a {
  border-radius: var(--md-radius-pill) !important;
  text-transform: none !important;
  font-weight: 500 !important;
}
.post-button .btn {
  background: var(--md-sys-color-primary) !important;
  color: var(--md-sys-color-on-primary) !important;
  border: none !important;
  box-shadow: var(--md-elevation-1) !important;
  padding: 6px 24px !important;
  margin-top: 12px !important;
}
.post-button .btn:hover {
  filter: brightness(.92) !important;
  box-shadow: var(--md-elevation-2) !important;
}
.pagination .page-number,
.pagination .extend {
  background: var(--md-sys-color-surface) !important;
  color: var(--md-sys-color-on-surface) !important;
  border: 1px solid var(--md-sys-color-outline-variant) !important;
  box-shadow: none !important;
}
.pagination .page-number.current,
.pagination .page-number:hover,
.pagination .extend:hover {
  background: var(--md-sys-color-primary) !important;
  color: var(--md-sys-color-on-primary) !important;
  border-color: var(--md-sys-color-primary) !important;
  box-shadow: var(--md-elevation-1) !important;
}
.menu-item a {
  color: var(--md-sys-color-on-surface) !important;
  border-radius: var(--md-radius-pill) !important;
}
.menu-item a:hover {
  background: var(--md-sys-state-primary) !important;
  color: var(--md-sys-color-primary) !important;
}

/* ---------- 7. 代码 ---------- */
.highlight {
  border-radius: var(--md-radius-sm) !important;
  box-shadow: var(--md-elevation-1) !important;
  border: none !important;
  margin: 16px 0 !important;
}
code, .post-body code, p code, li code, td code {
  background: var(--md-sys-color-surface-variant) !important;
  color: var(--md-sys-color-on-surface-variant) !important;
  border-radius: var(--md-radius-xs) !important;
  padding: 2px 6px !important;
}

/* ---------- 8. 引用 / 标签 / 图片 ---------- */
blockquote {
  border-left: 4px solid var(--md-sys-color-primary) !important;
  background: var(--md-sys-state-primary) !important;
  border-radius: 0 var(--md-radius-sm) var(--md-radius-sm) 0 !important;
  color: var(--md-sys-color-on-surface-variant) !important;
  padding: 12px 18px !important;
}
.post-tag, .article-tag, .tag-cloud a, .post-meta .post-tag {
  background: var(--md-sys-color-secondary-container) !important;
  color: var(--md-sys-color-on-secondary-container) !important;
  border-radius: var(--md-radius-pill) !important;
  padding: 2px 12px !important;
  margin: 3px !important;
  border: none !important;
}
.tag-cloud a:hover, .post-tag:hover {
  background: var(--md-sys-color-primary) !important;
  color: var(--md-sys-color-on-primary) !important;
}
.post-body img, .content img, .post-gallery img, img {
  border-radius: var(--md-radius-sm) !important;
}

/* ---------- 9. 页脚 / 搜索弹层 / note ---------- */
.footer { background: transparent !important; }
.footer-inner {
  text-align: center;
  color: var(--md-sys-color-on-surface-variant) !important;
}
.search-popup, .popup, .search-pop-overlay .popup {
  border-radius: var(--md-radius-md) !important;
  box-shadow: var(--md-elevation-3) !important;
  background: var(--md-sys-color-surface) !important;
}
.search-input, .search .input, .search-popup input {
  border-radius: var(--md-radius-pill) !important;
}
.search-result-title, .search-result .search-keyword {
  color: var(--md-sys-color-primary) !important;
}
.note {
  border-radius: var(--md-radius-sm) !important;
  border-left-width: 4px !important;
}
.note.primary {
  background: var(--md-sys-color-primary-container) !important;
  border-color: var(--md-sys-color-primary) !important;
  color: var(--md-sys-color-on-primary-container) !important;
}
.post-copyright {
  background: var(--md-sys-color-surface-variant) !important;
  border-radius: var(--md-radius-md) !important;
  border: none !important;
}
